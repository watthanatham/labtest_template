{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MVC",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/TemplateProject.dll",
      "args": [
        "--urls",
        "http://127.0.0.1:0"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)"
      }
    }
  ]
}
