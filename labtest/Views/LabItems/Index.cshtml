@model IReadOnlyList<LabItem>
@{
    ViewData["Title"] = "ทดสอบฐานข้อมูล";
}
<h1>ทดสอบฐานข้อมูล</h1>
<p>รายการเหล่านี้บันทึกลง SQLite ผ่าน Entity Framework Core</p>
<a class="btn btn-primary mb-3" asp-action="Create">เพิ่มรายการ</a>
@if (Model.Count == 0)
{
    <p class="text-muted">ยังไม่มีข้อมูล ลองเพิ่มรายการแรกเพื่อทดสอบการบันทึก</p>
}
else
{
    <table class="table">
        <thead><tr><th>ID</th><th>ชื่อรายการ</th><th>จัดการ</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                        <button class="btn btn-outline-danger btn-sm" type="submit">ลบ</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
